# Фиктивные значения. Создайте .env командой: uv run python scripts/bootstrap.py
# Не меняйте пароли существующего PostgreSQL/RabbitMQ volume без отдельной ротации.
POSTGRES_PASSWORD=replace-with-generated-local-password
CATALOG_DB_PASSWORD=replace-with-generated-local-password
REPOSITORIES_DB_PASSWORD=replace-with-generated-local-password
SECURITY_DB_PASSWORD=replace-with-generated-local-password
WORKSPACE_DB_PASSWORD=replace-with-generated-local-password
RABBITMQ_PASSWORD=replace-with-generated-local-password
DEV_ADMIN_TOKEN=replace-with-generated-local-token
# Необязательный токен только для GitHub worker; публичный smoke работает без него.
GITHUB_TOKEN=
# Для запуска web без Docker:
GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql
# Публичный origin для canonical; пустое значение = localhost и noindex.
SITE_URL=
